  "season_rules": {
    "Summer": {
      "preferred_fabrics": ["100% Organic Linen", "Cotton Silk", "Chiffon", "Georgette", "Khadi Cotton"],
      "avoid_fabrics": ["Heavy Velvet", "Thick Wool", "Heavy Brocade", "Synthetic Polyester"],
      "color_recommendations": ["Mint Green", "Soft Ivory", "Powder Blue", "Peach Pastel", "Blush Pink", "Crisp White", "Saffron Yellow"],
      "styling_focus": "Lightweight breathable fabrics with airy unlined cuts, pastel/light color palettes, short or half sleeves, and open sandals or Kolhapuri footwear to keep cool."
    },
    "Winter": {
      "preferred_fabrics": ["Plush Micro-Velvet", "Italian Tuxedo Wool", "Pure Banarasi Silk", "Pashmina", "Rich Brocade", "Tweed"],
      "avoid_fabrics": ["Ultra-thin Chiffon", "Sheer Net", "Unlined Linen"],
      "color_recommendations": ["Deep Emerald Green", "Royal Navy Blue", "Wine Burgundy", "Charcoal Black", "Ruby Red", "Rich Plum"],
      "styling_focus": "Warm, luxurious layered silhouettes (shawls, double-breasted blazers, high-neck blouses, full-sleeve sherwanis), deep rich dark jewel tones, and closed leather footwear."
    },
