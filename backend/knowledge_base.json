      "preferred_fabrics": ["Quick-dry Rayon", "Lightweight Crepe", "Georgette", "Fine Cotton Blend"],
      "avoid_fabrics": ["Delicate Pure Raw Silk", "Heavy Velvet", "Floor-sweeping Dupattas"],
      "color_recommendations": ["Teal", "Mustard Yellow", "Coral", "Dark Indigo Navy", "Olive Green"],
      "styling_focus": "Cropped ankle-length trouser/pant hem lengths to prevent mud splatters, vibrant moisture-resistant fabrics, and anti-slip block heels or treated leather footwear."
